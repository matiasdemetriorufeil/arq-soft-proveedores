go 1.26.1

// Los módulos del repo se desarrollan juntos: el workspace deja que los
// servicios importen pkg/observabilidad y pkg/mensajeria sin publicarlos ni
// fijar una versión. Las imágenes Docker no usan el workspace (ver el Dockerfile del
// gateway), así que cada módulo tiene que seguir compilando por su cuenta.
use (
	./pkg/mensajeria
	./pkg/observabilidad
	./services/api-gateway
	./services/import-service
	./services/proveedores-service
	./services/stock-service
)
