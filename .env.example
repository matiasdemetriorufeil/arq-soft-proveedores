# Copiá este archivo a .env antes de levantar el sistema:
#
#   Copy-Item .env.example .env     (PowerShell)
#   cp .env.example .env            (bash)
#
# .env está en .gitignore y no se versiona. Los valores de acá son para
# desarrollo local: no son secretos de ningún ambiente real, y por eso este
# archivo es el único del repo que puede tener credenciales.

# --- Postgres -----------------------------------------------------------------
# No se publica ningún puerto al host, así que no choca con un Postgres que ya
# tengas corriendo en 5432.
POSTGRES_USER=proveedores
POSTGRES_PASSWORD=proveedores-local
POSTGRES_DB=proveedores

# --- Capacidad compartida -----------------------------------------------------
# Claves que aceptan el gateway y proveedores-service, separadas por coma. Para
# la integración con el grupo de paneles solares se les da una propia y se
# agrega a esta lista.
API_KEYS=clave-de-desarrollo

# --- Gateway ------------------------------------------------------------------
# Puerto del host por el que entra todo. Cambialo si el 8080 está ocupado.
PUERTO_GATEWAY=8080
# Cuánto espera el gateway a una réplica antes de devolver 504.
TIMEOUT_UPSTREAM=3s
# Cada cuánto sondea /healthz de cada réplica.
INTERVALO_SALUD=5s

# --- Jaeger -------------------------------------------------------------------
# Puerto del host para la UI de trazas.
PUERTO_JAEGER=16686

# --- Base de stock-service ------------------------------------------------------
# Va en el mismo contenedor de Postgres, pero es otra base con otro usuario
# (una base por servicio). Se crea solo cuando el volumen de Postgres está
# vacío: si venías de la Entrega 2, corré una vez `docker compose down -v`.
STOCK_DB=stock
STOCK_DB_USER=stock
STOCK_DB_PASSWORD=stock-local

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=arqsoft
RABBITMQ_PASSWORD=rabbit-local
# Puerto del host para la UI de RabbitMQ (colas, cola de fallidos).
PUERTO_RABBITMQ_UI=15672

# --- MongoDB (import-service) -------------------------------------------------
MONGO_USER=arqsoft
MONGO_PASSWORD=mongo-local

# --- Redis (caché de proveedores-service) -------------------------------------
REDIS_PASSWORD=redis-local
# En false, la capacidad lee directo de PostgreSQL (para medir con y sin caché).
CACHE_HABILITADA=true

# --- Meilisearch (búsqueda) ---------------------------------------------------
# Tiene que tener 16 caracteres o más.
MEILI_MASTER_KEY=meili-local-clave-de-desarrollo

# --- FAV (grupo de ropa) ------------------------------------------------------
# Sin FAV_URL, import-service usa el mock local (servicio fav-mock). Cuando FAV
# tenga su URL desplegada, ponela acá junto con la clave que nos den.
FAV_URL=
FAV_API_KEY=clave-fav-desarrollo
# Flete fijo que le sumamos a cada oferta de FAV (su contrato no lo informa).
FAV_FLETE=0
# Cada cuánto se baja el catálogo. 5m es lo que dice ADR-009; para la demo se
# puede bajar (mínimo 10s).
INTERVALO_SINCRONIZACION=5m
# Puerto del host para controlar el mock (simular fallas en el Game Day).
PUERTO_FAV_MOCK=8090
